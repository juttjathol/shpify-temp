<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background | default: '#FDFBF7' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}

    {{ content_for_header }}

    {%- liquid
      assign heading_font = settings.type_heading_font
      assign body_font = settings.type_body_font
      assign heading_family = heading_font.family | default: 'Georgia'
      assign body_family = body_font.family | default: 'Helvetica Neue'
    -%}

    {%- comment -%}
      font_face emits raw @font-face CSS, so it has to sit inside a {% style %}
      block. Outside one the browser treats it as page text and prints the
      rules at the top of the storefront. The family name is the font's own
      name ("Bodoni Moda"), not a prefixed handle.
    {%- endcomment -%}
    {% style %}
      {%- if heading_font.system? == false -%}
        {{ heading_font | font_face: font_display: 'swap' }}
      {%- endif -%}
      {%- if body_font.system? == false -%}
        {{ body_font | font_face: font_display: 'swap' }}
      {%- endif -%}
    {% endstyle %}

    {%- render 'css-variables' -%}

    <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">

    <style>
      :root {
        --font-heading: {{ heading_family | escape }}, Georgia, "Times New Roman", serif;
        --font-body: {{ body_family | escape }}, "Helvetica Neue", Helvetica, Arial, sans-serif;
        --text-heading-transform: {{ settings.type_heading_transform | default: 'none' }};
      }
      h1, h2, h3, h4, h5, h6 { text-transform: var(--text-heading-transform); }
    </style>

    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'motion.js' | asset_url }}" defer></script>
  </head>

  <body
  class="template-{{ template.name | handle }}"
  {% if request.page_type == 'product' %}data-product-handle="{{ product.handle }}"{% endif %}
>
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.enable_motion -%}
      <button class="to-top" type="button" data-to-top aria-label="{{ 'general.accessibility.back_to_top' | t }}">
        {%- render 'icon', name: 'arrow-up', size: 18 -%}
      </button>
    {%- endif -%}
  </body>
</html>
