<div class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section__header">
        <h2 class="section__heading" data-split>{{ section.settings.heading }}</h2>
        {%- if section.settings.link_label != blank -%}
          <a class="text-link" href="{{ routes.collections_url }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-list">
      {%- if section.settings.use_blocks -%}
        {%- for block in section.blocks -%}
          <a class="collection-list__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {{ block.settings.title }}
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for collection in collections limit: section.settings.collections_to_show -%}
          <a class="collection-list__item" href="{{ collection.url }}">
            {{ collection.title }}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "collections_to_show", "min": 3, "max": 24, "step": 1, "label": "Collections to show", "default": 6 },
    { "type": "checkbox", "id": "use_blocks", "label": "Use the blocks below instead", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All collections" },
    { "type": "checkbox", "id": "flush_top", "label": "Remove space above", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Collection" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Collection list" }]
}
{% endschema %}
