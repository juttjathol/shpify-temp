<div class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.link_label != blank -%}
      <div class="section__header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <div class="section__subheading rte">{{ section.settings.subheading }}</div>
          {%- endif -%}
        </div>

        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.collection != blank -%}
      {%- assign target = section.settings.collection -%}
    {%- else -%}
      {%- assign target = collections.all -%}
    {%- endif -%}

    <div
      class="grid"
      data-card-grid
      style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: {{ section.settings.columns_tablet }}; --cols-desktop: {{ section.settings.columns_desktop }};"
    >
      {%- if target.products_count > 0 -%}
        {%- for product in target.products limit: section.settings.products_to_show -%}
          {%- comment -%} Above-the-fold images load eagerly, the rest lazily. {%- endcomment -%}
          {%- if forloop.index <= 4 -%}
            {%- render 'product-card', product: product, loading: 'eager' -%}
          {%- else -%}
            {%- render 'product-card', product: product, loading: 'lazy' -%}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif settings.demo_mode -%}
        {%- comment -%} Empty store: show samples so the grid still reads as a storefront. {%- endcomment -%}
        <div style="grid-column: 1 / -1;">
          <span class="demo-badge">Sample content</span>
          <p class="demo-card__note">Add a product to see the live grid. This layout is the one your customers will get.</p>
        </div>
        {%- for i in (1..section.settings.products_to_show) -%}
          {%- render 'demo-card', index: i -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 24, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns on mobile", "default": 2 },
    { "type": "range", "id": "columns_tablet", "min": 2, "max": 4, "step": 1, "label": "Columns on tablet", "default": 3 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "flush_top", "label": "Remove space above", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
