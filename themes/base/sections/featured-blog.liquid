<div class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="container">
    <div class="section__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="section__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank and section.settings.blog != blank -%}
        <a class="text-link" href="{{ section.settings.blog.url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.blog != blank and section.settings.blog.articles.size > 0 -%}
      <div
        class="grid"
        data-reveal-group="100"
        style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: {{ section.settings.columns }};"
      >
        {%- for article in section.settings.blog.articles limit: section.settings.posts_to_show -%}
          <article data-reveal>
            <a href="{{ article.url }}" style="display:block;">
              <div style="overflow:hidden; border-radius: var(--radius-card); background: var(--color-bg-soft);">
                {%- if article.image != blank -%}
                  <img
                    src="{{ article.image | image_url: width: 800 }}"
                    srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 800 }} 800w"
                    sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
                    alt="{{ article.image.alt | escape }}"
                    loading="lazy"
                    style="aspect-ratio: 4 / 3; object-fit: cover; transition: transform .6s var(--ease);"
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <p style="font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; color:var(--color-text-mute); margin-top:14px;">
                {{ article.published_at | date: format: 'month_day_year' }}
              </p>
              <h3 style="font-size:1.25rem; margin-top:6px;">{{ article.title | escape }}</h3>
            </a>
            {%- if article.excerpt != blank -%}
              <p style="color:var(--color-text-soft); margin-top:8px;">{{ article.excerpt | strip_html | truncatewords: 20 }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">
        <p>Choose a blog in this section to show posts here.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured blog",
  "tag": "section",
  "class": "section-blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 6, "step": 1, "label": "Posts to show", "default": 3 },
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns on desktop", "default": 3 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the journal" },
    { "type": "checkbox", "id": "flush_top", "label": "Remove space above", "default": false }
  ],
  "presets": [{ "name": "Featured blog" }]
}
{% endschema %}
