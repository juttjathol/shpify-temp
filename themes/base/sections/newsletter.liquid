<div class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="container">
    <div class="newsletter" data-reveal="clip">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow" style="color:inherit; opacity:.7;">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p style="opacity:.85; margin-top:12px;">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="field" style="margin:0;">
          <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">
            {{ 'general.newsletter.email' | t }}
          </label>
          <input
            class="field__input"
            id="NewsletterEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ 'general.newsletter.placeholder' | t }}"
            autocomplete="email"
            required
          >
        </div>

        {%- if form.posted_successfully? -%}
          <p class="form__message" style="color:inherit; margin-top:12px;">
            {{ 'general.newsletter.success' | t }}
          </p>
        {%- elsif form.errors -%}
          <p class="form__message form__message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}

        <button class="btn btn--primary btn--full" type="submit" style="margin-top:12px;">
          {{ section.settings.button_label | default: 'general.newsletter.submit' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ten percent off, always" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Be first to see new drops, restocks and the occasional invitation." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "checkbox", "id": "flush_top", "label": "Remove space above", "default": false }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
