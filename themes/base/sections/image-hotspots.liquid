{%- comment -%}
  Shoppable image. Merchants drop products onto an image with percentage
  coordinates, so a storefront sells the outfit rather than a flat photo.
  Positions are percentages, so they hold at every screen size.
{%- endcomment -%}

<div class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="container{% if section.settings.narrow %} container--narrow{% endif %}">
    {%- if section.settings.heading != blank -%}
      <div class="section__header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="section__heading">{{ section.settings.heading }}</h2>
        </div>
        {%- if section.settings.link_label != blank -%}
          <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hotspot-stage" data-hotspot-stage data-reveal="fade">
      {%- if section.settings.image != blank -%}
        <img
          class="hotspot-stage__image"
          src="{{ section.settings.image | image_url: width: 1600 }}"
          srcset="
            {{ section.settings.image | image_url: width: 700 }} 700w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w,
            {{ section.settings.image | image_url: width: 1800 }} 1800w
          "
          sizes="(min-width: 990px) 1000px, 100vw"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
        >
      {%- elsif settings.demo_mode -%}
        {%- render 'demo-media', variant: 3, ratio: '4 / 5', label: section.settings.heading -%}
      {%- endif -%}

      {%- for block in section.blocks -%}
        <button
          class="hotspot"
          type="button"
          style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
          data-hotspot-toggle
          aria-controls="Hotspot-{{ section.id }}-{{ block.id }}"
          aria-expanded="false"
          aria-label="{{ 'products.quick_view' | t }}: {{ block.settings.caption | escape }}"
        >
          <span class="hotspot__pulse" aria-hidden="true"></span>
        </button>

        <div
          class="hotspot__card"
          id="Hotspot-{{ section.id }}-{{ block.id }}"
          data-hotspot-card
        >
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 300 }}"
              width="240"
              height="240"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
            >
          {%- endif -%}
          <p class="hotspot__card-title">{{ block.settings.caption }}</p>
          {%- if block.settings.price != blank -%}
            <p class="hotspot__card-price">{{ block.settings.price }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            <a class="text-link" style="margin-top:8px; display:inline-block;" href="{{ block.settings.link }}">
              {{ 'products.view' | t }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with hotspots",
  "tag": "section",
  "class": "section-hotspots",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait works best. The dots are placed as a percentage, so they hold at any width." },
    { "type": "checkbox", "id": "narrow", "label": "Narrow the stage", "default": false },
    { "type": "checkbox", "id": "flush_top", "label": "Remove space above", "default": false }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "text", "id": "caption", "label": "Caption", "default": "Product" },
        { "type": "image_picker", "id": "image", "label": "Thumbnail" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "range",
          "id": "x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Position across",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Position down",
          "default": 50
        }
      ]
    }
  ],
  "presets": [{ "name": "Image with hotspots" }]
}
{% endschema %}
