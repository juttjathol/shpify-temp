<div class="section{% if section.settings.flush_top %} section--flush-top{% endif %}">
  <div class="container{% if section.settings.narrow %} container--narrow{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.content != blank -%}
      <div class="rte">{{ section.settings.content }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="btn btn--outline" href="{{ section.settings.button_link }}" style="margin-top:24px;">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "content", "label": "Text", "default": "<p>Use this section for brand story, store policies, or anything else you want to say in your own words.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow the text column", "default": true },
    { "type": "checkbox", "id": "flush_top", "label": "Remove space above", "default": false }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
