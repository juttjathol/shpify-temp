<div class="container">
  <div class="error-404">
    <p class="error-404__code">404</p>
    <h1 class="error-404__title">{{ section.settings.heading }}</h1>
    <p class="error-404__text">{{ section.settings.text }}</p>

    <div class="error-404__actions">
      <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
      <a class="btn btn--outline" href="{{ routes.root_url }}">
        {{ 'general.accessibility.home' | t }}
      </a>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div style="width:100%; max-width:560px; margin-top:56px; text-align:left;">
        {%- for block in section.blocks -%}
          <details class="collapsible" {{ block.shopify_attributes }}>
            <summary class="collapsible__summary">
              {{ block.settings.heading }}
              <span class="collapsible__icon">{%- render 'icon', name: 'chevron-down', size: 18 -%}</span>
            </summary>
            <div class="collapsible__content rte">{{ block.settings.content }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We can't find that page" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The page may have moved, or the link may be out of date. Try starting again from the shop." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Continue shopping" }
  ],
  "blocks": [
    {
      "type": "collapsible",
      "name": "Collapsible",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Orders ship within two business days.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "404 page" }]
}
{% endschema %}
