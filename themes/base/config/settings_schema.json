        "default": "Made to be worn for years"
      },
      {
        "type": "textarea",
        "id": "hero_text",
        "label": "Text",
        "default": "Small-batch pieces in natural fibres, made in limited runs."
      },
      {
        "type": "text",
        "id": "hero_button_label",
        "label": "Button label",
        "default": "Shop the collection"
