      {
        "type": "color",
        "id": "color_announcement_bg",
        "label": "Background",
        "default": "#1C1917"
      },
      {
        "type": "color",
        "id": "color_announcement_text",
        "label": "Text",
        "default": "#FDFBF7"
      },
      {
        "type": "checkbox",
        "id": "announcement_dismissible",
        "label": "Let customers dismiss it",
        "default": true
