  {
    "name": "Motion & features",
    "settings": [
      {
        "type": "paragraph",
        "content": "These add polish to the storefront. Everything here is also switched off automatically when a visitor has reduced motion set."
      },
      {
        "type": "checkbox",
        "id": "enable_motion",
        "label": "Scroll animations and transitions",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_quick_view",
        "label": "Quick view on product cards",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_recently_viewed",
        "label": "Recently viewed on product pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_atc",
        "label": "Sticky add to cart on mobile",
        "default": true
      },
      {
        "type": "range",
        "id": "image_zoom",
        "min": 100,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "Product image hover zoom",
        "default": 105
      },
      {
        "type": "header",
        "content": "Sample content"
      },
      {
        "type": "checkbox",
        "id": "demo_mode",
        "label": "Show sample content when the store is empty",
        "default": true,
        "info": "Adds placeholder imagery and sample products so a new store never looks broken. Disappears automatically once real products are added."
      }
    ]
