[
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 140
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Logo text",
        "info": "Shown when no logo image is uploaded. Leave the store name to use it."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, 32x32 or larger. Uploaded to Shopify with the theme."
      },
      {
        "type": "image_picker",
        "id": "social_share_image",
        "label": "Social share image",
        "info": "Shown when the store is shared on social platforms. 1200x630 works well."
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Fonts are loaded from Shopify's font library and render on every page."
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "bodoni_moda_n7"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "type_heading_size",
        "min": 24,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Base heading size",
        "default": 40
      },
      {
        "type": "range",
        "id": "type_body_size",
        "min": 13,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Base body size",
        "default": 16
      },
      {
        "type": "range",
        "id": "type_body_line_height",
        "min": 12,
        "max": 24,
        "step": 1,
        "unit": "x",
        "label": "Body line height",
        "default": 16
      },
      {
        "type": "select",
        "id": "type_heading_transform",
        "label": "Heading letter case",
        "default": "none",
        "options": [
          {
            "value": "none",
            "label": "As typed"
          },
          {
            "value": "uppercase",
            "label": "Uppercase"
          },
          {
            "value": "lowercase",
            "label": "Lowercase"
          }
        ]
      }
    ]
  },
