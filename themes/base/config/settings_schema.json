  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "checkbox",
        "id": "header_sticky",
        "label": "Stick to the top when scrolling",
        "default": true
      },
      {
        "type": "link_list",
        "id": "header_menu",
        "label": "Menu",
        "default": "main-menu"
      },
      {
        "type": "range",
        "id": "header_height",
        "min": 48,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Header height",
        "default": 72
      },
      {
        "type": "select",
        "id": "header_layout",
        "label": "Logo position",
        "default": "center",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_search",
        "label": "Show search",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_account",
        "label": "Show account link",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart",
        "label": "Show cart",
        "default": true
      }
    ]
  },
  {
    "name": "Home page hero",
    "settings": [
      {
        "type": "paragraph",
        "content": "Defaults for the hero banner. Each hero section on the page can override them."
      },
      {
        "type": "text",
        "id": "hero_heading",
