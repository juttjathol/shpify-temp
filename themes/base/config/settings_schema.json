  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1280
      },
      {
        "type": "range",
        "id": "container_padding",
        "min": 12,
        "max": 64,
        "step": 4,
        "unit": "px",
        "label": "Page side padding",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 24,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Space between sections",
        "default": 72
      },
      {
        "type": "range",
        "id": "grid_gap",
        "min": 8,
        "max": 48,
        "step": 4,
        "unit": "px",
        "label": "Grid gap",
        "default": 24
      },
      {
        "type": "range",
        "id": "radius_card",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 4
      },
      {
        "type": "range",
        "id": "radius_button",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 2
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Text",
        "default": "Complimentary shipping on orders over $150"
