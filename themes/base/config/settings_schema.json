      {
        "type": "url",
        "id": "hero_button_link",
        "label": "Button link"
      },
      {
        "type": "image_picker",
        "id": "hero_image",
        "label": "Image"
      },
      {
        "type": "image_picker",
        "id": "hero_mobile_image",
        "label": "Mobile image",
        "info": "Optional. Shown on small screens instead of the desktop image."
