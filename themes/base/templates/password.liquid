<div class="container container--narrow" style="text-align:center; max-width:520px;">
  {%- if shop.brand.logo != blank or settings.logo != blank -%}
    {%- assign logo = settings.logo | default: shop.brand.logo -%}
    <img
      src="{{ logo | image_url: width: 320 }}"
      width="160"
      alt="{{ shop.name | escape }}"
      style="margin:0 auto 32px;"
    >
  {%- else -%}
    <h1 style="font-family: var(--font-heading); font-size:2.5rem; margin-bottom:16px;">{{ shop.name }}</h1>
  {%- endif -%}

  <h2 style="font-family: var(--font-heading); font-size:1.75rem; margin-bottom:12px;">
    {{ 'password_page.opening_soon' | t }}
  </h2>
  <p style="color: var(--color-text-soft); margin-bottom:28px;">{{ 'password_page.message' | t }}</p>

  {%- form 'storefront_password', class: 'form' -%}
    <label class="field__label" for="Password">{{ 'password_page.password' | t }}</label>
    <input
      class="field__input"
      id="Password"
      type="password"
      name="password"
      autocomplete="current-password"
      style="text-align:center; margin-bottom:16px;"
    >
    <button class="btn btn--primary btn--full" type="submit">{{ 'password_page.enter' | t }}</button>
  {%- endform -%}

  <p style="font-size:.8125rem; color: var(--color-text-mute); margin-top:40px;">
    {{ 'powered_by' | t }}
  </p>
</div>
