{%- comment -%}
  Renders a Shopify-cached image at the widths a card actually needs.
  Usage: {% render 'responsive-image', image: product.featured_image, sizes: '(min-width: 750px) 25vw, 50vw', ratio: '3 / 4' %}
  Falls back to the theme placeholder when the image is blank, so a card never
  renders as a collapsed box.
{%- endcomment -%}
{%- if image != blank -%}
  <img
    src="{{ image | image_url: width: 400 }}"
    srcset="
      {{ image | image_url: width: 200 }} 200w,
      {{ image | image_url: width: 400 }} 400w,
      {{ image | image_url: width: 600 }} 600w,
      {{ image | image_url: width: 800 }} 800w,
      {{ image | image_url: width: 1200 }} 1200w
    "
    sizes="{{ sizes | default: '100vw' }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    loading="{{ loading | default: 'lazy' }}"
    alt="{{ image.alt | escape }}"
    {% if ratio %}style="aspect-ratio: {{ ratio }}; object-fit: cover;"{% endif %}
  >
{%- else -%}
  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
{%- endif -%}
