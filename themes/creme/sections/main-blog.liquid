{%- comment -%}Blog index: article grid with pagination.{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-blog.css' | asset_url | stylesheet_tag }}
{{ 'component-pagination.css' | asset_url | stylesheet_tag }}

<div class="section">
  <div class="container">
    <header class="blog__header">
      <h1 class="h1">{{ blog.title }}</h1>
      {%- if blog.description != blank -%}
        <div class="rte blog__header-text">{{ blog.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate blog.articles by section.settings.posts_per_page -%}
      {%- if blog.articles.size > 0 -%}
        <div class="grid" style="--card-min:{{ section.settings.columns_desktop }}px">
          {%- for article in blog.articles -%}
            <c-animate data-delay="{{ forloop.index0 | times: 50 }}">
              {%- render 'article-card', card_article: article -%}
            </c-animate>
          {%- endfor -%}
        </div>
        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <div class="collection__empty">
          {%- render 'icon', name: 'search', size: 48 -%}
          <p class="text-ink-soft">{{ 'blogs.empty' | t }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-blog.name",
  "settings": [
    { "type": "range", "id": "posts_per_page", "label": "t:sections.main-blog.settings.posts_per_page.label", "min": 3, "max": 24, "step": 3, "default": 9 },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.main-blog.settings.columns_desktop.label", "min": 220, "max": 480, "step": 20, "unit": "px", "default": 320 }
  ]
}
{% endschema %}
