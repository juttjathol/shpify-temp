{%- comment -%}
  Journal / blog teaser. Picks a blog, then pulls the newest posts (or a
  hand-picked set of article blocks).
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign selected = section.blocks | where: 'type', 'article'
  assign articles = selected
  if articles.size == 0 and section.settings.blog != blank
    assign articles = blogs[section.settings.blog].articles | slice: 0, section.settings.posts_to_show
  endif
-%}

{%- if articles.size > 0 -%}
  <section class="section{% if section.settings.remove_top_padding %} section--flush-top{% endif %}{% if section.settings.remove_bottom_padding %} section--flush-bottom{% endif %}">
    <div class="container">
      {%- render 'section-header',
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        heading_tag: section.settings.heading_tag,
        align: section.settings.header_alignment,
        link_label: section.settings.link_label,
        link_url: section.settings.link_url -%}

      <div class="grid" style="--card-min:{{ section.settings.columns_desktop }}px">
        {%- for article in articles -%}
          <c-animate data-delay="{{ forloop.index0 | times: 60 }}">
            {%- if article.id -%}
              {%- render 'article-card', card_article: article -%}
            {%- else -%}
              {%- render 'article-card', card_article: article.settings.article -%}
            {%- endif -%}
          </c-animate>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.featured-blog.name",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.featured-blog.settings.heading.label", "default": "From the journal" },
    { "type": "textarea", "id": "subheading", "label": "t:sections.featured-blog.settings.subheading.label" },
    { "type": "select", "id": "heading_tag", "label": "t:sections.featured-blog.settings.heading_tag.label", "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ] },
    { "type": "blog", "id": "blog", "label": "t:sections.featured-blog.settings.blog.label" },
    { "type": "range", "id": "posts_to_show", "label": "t:sections.featured-blog.settings.posts_to_show.label", "min": 2, "max": 12, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.featured-blog.settings.columns_desktop.label", "min": 200, "max": 480, "step": 20, "unit": "px", "default": 300 },
    {
      "type": "select", "id": "header_alignment", "label": "t:sections.featured-blog.settings.header_alignment.label", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ] },
    { "type": "text", "id": "link_label", "label": "t:sections.featured-blog.settings.link_label.label", "default": "Read the journal" },
    { "type": "url", "id": "link_url", "label": "t:sections.featured-blog.settings.link_url.label" },
    { "type": "checkbox", "id": "remove_top_padding", "label": "t:sections.featured-blog.settings.remove_top_padding.label", "default": false },
    { "type": "checkbox", "id": "remove_bottom_padding", "label": "t:sections.featured-blog.settings.remove_bottom_padding.label", "default": false }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "t:sections.featured-blog.blocks.article.name",
      "settings": [
        { "type": "article", "id": "article", "label": "t:sections.featured-blog.blocks.article.settings.article.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-blog.presets.default",
      "blocks": [{ "type": "article" }, { "type": "article" }, { "type": "article" }]
    }
  ]
}
{% endschema %}
