{%- comment -%}Search results page with a form, product results and pagination.{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-pagination.css' | asset_url | stylesheet_tag }}

<div class="section">
  <div class="container">
    <header style="text-align:center;margin-bottom:32px">
      <h1 class="h1">
        {%- if search.performed -%}
          {{ 'general.search.results_for' | t: terms: search.terms }}
        {%- else -%}
          {{ 'general.search.title' | t }}
        {%- endif -%}
      </h1>

      <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:560px;margin:20px auto 0">
        <div class="search-panel__form" style="border-bottom-color:var(--color-ink)">
          <label class="visually-hidden" for="PageSearchInput">{{ 'general.search.title' | t }}</label>
          <input
            class="search-panel__input"
            id="PageSearchInput"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t | escape }}"
          >
          <button class="btn btn--accent btn--sm" type="submit">{{ 'general.search.submit' | t }}</button>
        </div>
      </form>
    </header>

    {%- if search.performed -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        {%- if search.results_count > 0 -%}
          <p class="collection__count" style="margin-bottom:20px">
            {{ 'general.search.results_count' | t: count: search.results_count }}
          </p>

          <div class="grid" style="--card-min:{{ section.settings.columns_desktop }}px">
            {%- for item in search.results -%}
              <c-animate data-delay="{{ forloop.index0 | times: 50 }}">
                {%- case item.object_type -%}
                  {%- when 'product' -%}
                    {%- render 'product-card', card_product: item -%}
                  {%- when 'article' -%}
                    {%- render 'article-card', card_article: item -%}
                  {%- else -%}
                    <a class="collection-card" href="{{ item.url }}">
                      <h3 class="collection-card__title">{{ item.title }}</h3>
                      <p class="text-body-sm text-ink-soft">{{ item.content | strip_html | truncate: 140 }}</p>
                    </a>
                {%- endcase -%}
              </c-animate>
            {%- endfor -%}
          </div>

          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <div class="collection__empty">
            {%- render 'icon', name: 'search', size: 48 -%}
            <p class="text-ink-soft">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
            <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}">{{ 'general.nav.shop_all' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-search.name",
  "settings": [
    { "type": "range", "id": "results_per_page", "label": "t:sections.main-search.settings.results_per_page.label", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.main-search.settings.columns_desktop.label", "min": 180, "max": 460, "step": 20, "unit": "px", "default": 260 }
  ]
}
{% endschema %}
