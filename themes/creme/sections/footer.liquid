{%- comment -%}
  Footer: brand column, up to 4 link menus, contact details, social icons,
  newsletter prompt and payment marks.
{%- endcomment -%}
{%- liquid
  assign show_social = settings.footer_show_social
  assign show_policy = settings.footer_show_policy_links
  assign footer_text = section.settings.text | default: settings.footer_text
  assign contact_email = section.settings.email | default: settings.footer_email
  assign contact_phone = section.settings.phone | default: settings.footer_phone
  assign contact_address = section.settings.address | default: settings.footer_address
  assign column_count = settings.footer_columns | default: 3

  # "Footer background colour" in Theme settings wins when the merchant turns
  # on the override; otherwise the section's cream / dark scheme applies.
  if settings.footer_use_color_override
    assign scheme = 'custom'
  else
    assign scheme = section.settings.color_scheme
  endif
-%}
{{ 'component-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

<footer class="footer footer--{{ scheme }}" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      {%- comment -%} Brand column {%- endcomment -%}
      <div class="footer__col footer__col--brand">
        <div class="footer__logo">
          {%- if section.settings.logo != blank -%}
            {%- render 'responsive-image', image: section.settings.logo, sizes: '200px', class: 'footer__logo-image', loading: 'lazy', ratio_class: 'auto' -%}
          {%- elsif shop.brand.logo -%}
            {%- render 'responsive-image', image: shop.brand.logo, sizes: '200px', class: 'footer__logo-image', loading: 'lazy', ratio_class: 'auto' -%}
          {%- else -%}
            <span class="footer__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </div>

        {%- if footer_text != blank -%}
          <p class="footer__text">{{ footer_text }}</p>
        {%- endif -%}

        {%- if section.settings.show_contact -%}
          <div class="footer__contact" style="margin-top:18px">
            {%- if contact_email != blank -%}
              <a class="footer__contact-item" href="mailto:{{ contact_email }}">
                {%- render 'icon', name: 'email', size: 15 -%}
                <span>{{ contact_email }}</span>
              </a>
            {%- endif -%}
            {%- if contact_phone != blank -%}
              <a class="footer__contact-item" href="tel:{{ contact_phone | remove: ' ' | remove: '-' }}">
                {%- render 'icon', name: 'phone', size: 15 -%}
                <span>{{ contact_phone }}</span>
              </a>
            {%- endif -%}
            {%- if contact_address != blank -%}
              <div class="footer__contact-item">
                {%- render 'icon', name: 'pin', size: 15 -%}
                <span>{{ contact_address | newline_to_br }}</span>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if show_social -%}
          {%- render 'social-icons', size: 17 -%}
        {%- endif -%}
      </div>

      {%- comment -%} Menu columns {%- endcomment -%}
      {%- for block in section.blocks limit: column_count -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h3 class="footer__heading footer__col-heading">{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.settings.type == 'menu' and block.settings.menu != blank -%}
            <ul class="footer__list">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a class="footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- elsif block.settings.type == 'text' -%}
            <div class="rte footer__text" style="font-size:.9rem">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Bottom bar {%- endcomment -%}
    <div class="footer__bottom">
      <div class="footer__legal">
        <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}</span>
        {%- if show_policy and shop.privacy_policy -%}
          <a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>
        {%- endif -%}
        {%- if show_policy and shop.terms_of_service -%}
          <a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>
        {%- endif -%}
        {%- if show_policy and section.settings.refund_policy != blank -%}
          <a href="{{ section.settings.refund_policy }}">{{ 'general.footer.refund_policy' | t }}</a>
        {%- endif -%}
      </div>

      <div class="footer__payments">
        <span class="visually-hidden">{{ 'general.footer.payment_methods' | t }}</span>
        {%- render 'payment-icons' -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "t:sections.footer.settings.logo.label" },
    { "type": "textarea", "id": "text", "label": "t:sections.footer.settings.text.label", "default": "Small-batch fashion, made with natural fibres and a lighter footprint." },
    { "type": "checkbox", "id": "show_contact", "label": "t:sections.footer.settings.show_contact.label", "default": true },
    { "type": "text", "id": "email", "label": "t:sections.footer.settings.email.label" },
    { "type": "text", "id": "phone", "label": "t:sections.footer.settings.phone.label" },
    { "type": "textarea", "id": "address", "label": "t:sections.footer.settings.address.label" },
    { "type": "checkbox", "id": "show_social", "label": "t:sections.footer.settings.show_social.label", "default": true },
    { "type": "checkbox", "id": "show_policy_links", "label": "t:sections.footer.settings.show_policy_links.label", "default": true },
    { "type": "url", "id": "refund_policy", "label": "t:sections.footer.settings.refund_policy.label" },
    {
      "type": "select", "id": "color_scheme", "label": "t:sections.footer.settings.color_scheme.label", "default": "cream",
      "options": [
        { "value": "cream", "label": "Cream" },
        { "value": "ink", "label": "Dark" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.menu.settings.heading.label", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "t:sections.footer.blocks.menu.settings.menu.label", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.footer.blocks.text.settings.heading.label", "default": "About" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.text.settings.text.label", "default": "<p>Founded in a small studio, we make considered pieces designed to be worn for years, not seasons.</p>" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
