{%- comment -%}
  Product page: media gallery, variant selector, add to cart, accordions,
  share links, and an @app block slot for review apps.
  Falls back to a plain form post if JavaScript never loads.
{%- endcomment -%}
{{ 'component-main-product.css' | asset_url | stylesheet_tag }}

{{ 'product-form.js' | asset_url | script_tag: defer: true }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_variants = false
  if product.options_with_values.size > 0
    assign has_variants = true
  endif

  assign product_form_id = 'ProductForm-' | append: section.id

  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
  endif

  assign badge_new = false
  if product.tags contains 'New' or product.tags contains 'new'
    assign badge_new = true
  endif
-%}

{%- comment -%} Build a minimal variant payload (no inventory levels exposed) {%- endcomment -%}
{%- liquid
  assign variants_json = '['
  for variant in product.variants
    assign cap = variant.compare_at_price | default: 0
    assign sku = variant.sku | default: ''
    assign media_id = 0
    if variant.featured_media
      assign media_id = variant.featured_media.id
    endif

    assign options_json = '['
    assign sep = ''
    for option in variant.options
      assign options_json = options_json | append: sep | append: option | json
      assign sep = ','
    endfor
    assign options_json = options_json | append: ']'

    assign inv_mgmt = variant.inventory_management | default: ''
    assign chunk = '"id":' | append: variant.id | append: ',"title":' | append: variant.title | json | append: ',"options":' | append: options_json | append: ',"price":' | append: variant.price | append: ',"compare_at_price":' | append: cap | append: ',"available":' | append: variant.available | append: ',"inventory_management":' | append: inv_mgmt | json | append: ',"sku":' | append: sku | json | append: ',"featured_media_id":' | append: media_id

    assign variants_json = variants_json | append: chunk
    unless forloop.last
      assign variants_json = variants_json | append: ','
    endunless
  endfor
  assign variants_json = variants_json | append: ']'
-%}

<section class="section" id="ProductSection-{{ section.id }}" data-product-root>
  <div class="container{% if section.settings.full_width %} container--wide{% endif %}">
    {%- render 'breadcrumbs' -%}

    <div class="product">
      {%- comment -%} Media gallery {%- endcomment -%}
      <div class="product__media-col">
        {%- if product.media.size > 0 -%}
          <c-gallery class="gallery">
            {%- for media in product.media -%}
              <div
                class="gallery__item"
                data-gallery-item="{{ media.id }}"
                {% if forloop.index > 1 %}hidden{% endif %}
              >
                <div class="gallery__item-media media media--{{ section.settings.image_ratio }}">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      <img
                        src="{{ media | image_url: width: 1400 }}"
                        srcset="
                          {{ media | image_url: width: 400 }} 400w,
                          {{ media | image_url: width: 600 }} 600w,
                          {{ media | image_url: width: 800 }} 800w,
                          {{ media | image_url: width: 1000 }} 1000w,
                          {{ media | image_url: width: 1400 }} 1400w,
                          {{ media | image_url: width: 1800 }} 1800w
                        "
                        sizes="(min-width: 990px) 55vw, 100vw"
                        width="{{ media.preview_image.width }}"
                        height="{{ media.preview_image.height }}"
                        alt="{{ media.alt | escape }}"
                        loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                        {% if forloop.first %}fetchpriority="high"{% endif %}
                        decoding="async"
                        style="width:100%;height:100%;object-fit:cover;"
                      >
                    {%- when 'video' -%}
                      {{ media | video_tag: image_size: '1200x', controls: true, muted: true, loop: true, class: 'w-full' }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag }}
                    {%- when 'model' -%}
                      {{ media | model_viewer_tag }}
                    {%- else -%}
                      {{ media | media_tag }}
                  {%- endcase -%}
                </div>

                {%- if forloop.first and on_sale -%}
                  <span class="badge badge--sale gallery__badge">{{ 'products.sale' | t }}</span>
                {%- elsif forloop.first and badge_new -%}
                  <span class="badge badge--new gallery__badge">{{ 'products.new' | t }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}

            {%- if product.media.size > 1 -%}
              <div class="gallery__thumbs" role="tablist" aria-label="{{ 'products.gallery' | t | escape }}">
                {%- for media in product.media -%}
                  <button
                    class="gallery__thumb{% if forloop.first %} is-active{% endif %}"
                    type="button"
                    data-gallery-thumb="{{ media.id }}"
                >
                    {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt, width: 160, height: 160 }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </c-gallery>
        {%- else -%}
          <div class="media media--{{ section.settings.image_ratio }}">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product info {%- endcomment -%}
      <div class="product__info-col">
        {%- if product.vendor != blank -%}
          <p class="product__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product__title h1">{{ product.title }}</h1>

        {%- if section.settings.show_rating -%}
          <div class="product__rating">
            {%- render 'icon', name: 'star', size: 15 -%}
            <span>{{ 'products.rating_placeholder' | t }}</span>
          </div>
        {%- endif -%}

        <div class="product__price-row">
          <div class="product__price" data-product-price>
            {%- if on_sale -%}
              <del>{{ current_variant.compare_at_price | money }}</del>
              <ins>{{ current_variant.price | money }}</ins>
            {%- else -%}
              <span>{{ current_variant.price | money }}</span>
            {%- endif -%}
          </div>
          <span class="product__tax-note text-ink-mute" data-product-stock>
            {%- if current_variant.available -%}
              {{ 'products.in_stock' | t }}
            {%- else -%}
              {{ 'products.sold_out' | t }}
            {%- endif -%}
          </span>
        </div>

        <c-product-form
          class="product__form"
          data-variants='{{ variants_json }}'
          data-section-id="{{ section.id }}"
          data-update-url
          data-in-stock-text="{{ 'products.in_stock' | t | escape }}"
          data-sold-out-text="{{ 'products.sold_out' | t | escape }}"
          data-add-text="{{ 'products.add_to_cart' | t | escape }}"
          data-added-text="{{ 'products.added' | t | escape }}"
        >
          {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate' -%}
            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign option_name = option.name
                  assign is_color = false
                  if option_name == 'Color' or option_name == 'Colour' or option_name == 'color'
                    assign is_color = true
                  endif
                -%}
                <div class="product__option" data-option-value="{{ option_name }}">
                  <div class="product__option-label">
                    <span>{{ option.name }}:</span>
                    <span class="product__option-value" data-option-label="{{ option_name }}">{{ option.selected_value }}</span>
                  </div>

                  {%- if is_color -%}
                    <div class="variant-selector">
                      {%- for value in option.values -%}
                        {%- assign variant_for_value = product.variants | where: option_name, value | first -%}
                        <input
                          class="variant-input"
                          type="radio"
                          id="opt-{{ section.id }}-{{ option_name }}-{{ value | handle }}"
                          name="option-{{ option.position }}"
                          value="{{ value | escape }}"
                          form="{{ product_form_id }}"
                          data-option-input
                          {% if option.selected_value == value %}checked="checked"{% endif %}
                          {% if variant_for_value == false %}disabled="disabled"{% endif %}
                        >
                        <label
                          class="variant-chip"
                          for="opt-{{ section.id }}-{{ option_name }}-{{ value | handle }}"
                        >
                          <span class="variant-chip__swatch" style="background:{{ value | handle | replace: '-', ' ' }}"></span>
                          {{ value }}
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="variant-selector">
                      {%- for value in option.values -%}
                        {%- assign variant_for_value = product.variants | where: option_name, value | first -%}
                        <input
                          class="variant-input"
                          type="radio"
                          id="opt-{{ section.id }}-{{ option_name }}-{{ value | handle }}"
                          name="option-{{ option.position }}"
                          value="{{ value | escape }}"
                          form="{{ product_form_id }}"
                          data-option-input
                          {% if option.selected_value == value %}checked="checked"{% endif %}
                          {% if variant_for_value == false %}disabled="disabled"{% endif %}
                        >
                        <label
                          class="variant-chip"
                          for="opt-{{ section.id }}-{{ option_name }}-{{ value | handle }}"
                        >{{ value }}</label>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- endunless -%}

            <div class="product__form-row">
              {%- if section.settings.show_quantity_selector -%}
                <div class="quantity" data-quantity>
                  <button class="quantity__btn" type="button" data-quantity-down aria-label="{{ 'products.quantity_decrease' | t | escape }}">
                    {%- render 'icon', name: 'minus', size: 12 -%}
                  </button>
                  <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                  <input
                    class="quantity__input"
                    id="Quantity-{{ section.id }}"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    inputmode="numeric"
                  >
                  <button class="quantity__btn" type="button" data-quantity-up aria-label="{{ 'products.quantity_increase' | t | escape }}">
                    {%- render 'icon', name: 'plus', size: 12 -%}
                  </button>
                </div>
              {%- endif -%}

              <button
                class="btn btn--accent btn--lg"
                type="submit"
                name="add"
                form="{{ product_form_id }}"
                data-product-submit
                {% unless current_variant.available %}disabled="disabled"{% endunless %}
              >
                {%- if current_variant.available -%}
                  {{ 'products.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.sold_out' | t }}
                {%- endif -%}
              </button>
            </div>
          {%- endform -%}
        </c-product-form>

        {%- render 'shipping-bar' -%}

        {%- if product.description != blank or section.blocks.size > 0 -%}
          <div class="product__accordion">
            {%- for block in section.blocks -%}
              <c-accordion-item class="product__accordion-item" id="pacc-{{ block.id }}">
                <button class="product__accordion-trigger" type="button" data-accordion-trigger aria-expanded="false">
                  <span>{{ block.settings.heading }}</span>
                  {%- render 'icon', name: 'chevron-down', size: 12 -%}
                </button>
                <div class="product__accordion-panel rte" data-accordion-panel>
                  {%- case block.type -%}
                    {%- when 'description' -%}
                      {{ product.description }}
                    {%- when 'text' -%}
                      {{ block.settings.text }}
                    {%- when 'share' -%}
                      {%- render 'social-share', url: product.url, title: product.title, show_whatsapp: true, show_copy: true -%}
                    {%- when 'custom_liquid' -%}
                      {{ block.settings.custom_liquid }}
                    {%- when '@app' -%}
                      {%- render block -%}
                  {%- endcase -%}
                </div>
              </c-accordion-item>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "t:sections.main-product.settings.full_width.label", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "t:sections.main-product.settings.show_rating.label", "default": false },
    { "type": "checkbox", "id": "show_quantity_selector", "label": "t:sections.main-product.settings.show_quantity_selector.label", "default": true },
    {
      "type": "select", "id": "image_ratio", "label": "t:sections.main-product.settings.image_ratio.label", "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "description",
      "name": "t:sections.main-product.blocks.description.name",
      "settings": []
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.main-product.blocks.text.settings.heading.label", "default": "Shipping & returns" },
        { "type": "richtext", "id": "text", "label": "t:sections.main-product.blocks.text.settings.text.label", "default": "<p>Complimentary shipping on orders over $150. Returns accepted within 30 days.</p>" }
      ]
    },
    {
      "type": "share",
      "name": "t:sections.main-product.blocks.share.name",
      "settings": []
    },
    { "type": "@app" }
  ]
}
{% endschema %}
