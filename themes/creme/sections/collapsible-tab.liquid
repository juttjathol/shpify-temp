{%- comment -%}
  FAQ / details list. Each row is the reusable `collapsible` theme block,
  whose panel accepts nested content blocks.
{%- endcomment -%}
{{ 'component-section.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

<section class="section{% if section.settings.remove_top_padding %} section--flush-top{% endif %}{% if section.settings.remove_bottom_padding %} section--flush-bottom{% endif %}">
  <div class="container container--narrow">
    {%- render 'section-header',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      heading_tag: section.settings.heading_tag,
      align: section.settings.header_alignment -%}

    <div class="accordion" data-accordion-single>
      {%- for block in section.blocks -%}
        {%- render block -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collapsible-tab.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.collapsible-tab.settings.heading.label", "default": "Frequently asked" },
    { "type": "textarea", "id": "subheading", "label": "t:sections.collapsible-tab.settings.subheading.label" },
    { "type": "select", "id": "heading_tag", "label": "t:sections.collapsible-tab.settings.heading_tag.label", "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ] },
    {
      "type": "select", "id": "header_alignment", "label": "t:sections.collapsible-tab.settings.header_alignment.label", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ] },
    { "type": "checkbox", "id": "remove_top_padding", "label": "t:sections.collapsible-tab.settings.remove_top_padding.label", "default": false },
    { "type": "checkbox", "id": "remove_bottom_padding", "label": "t:sections.collapsible-tab.settings.remove_bottom_padding.label", "default": false }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "t:sections.collapsible-tab.presets.default",
      "blocks": {
        "q1": { "type": "collapsible", "settings": { "heading": "What is your return policy?" }, "blocks": { "a1": { "type": "text", "settings": { "text": "<p>Send anything back within 30 days, unworn and with tags attached, and we will refund you in full.</p>" } } } },
        "q2": { "type": "collapsible", "settings": { "heading": "Do you ship internationally?" }, "blocks": { "a2": { "type": "text", "settings": { "text": "<p>Yes — duties are calculated at checkout so there is nothing to pay on delivery.</p>" } } } },
        "q3": { "type": "collapsible", "settings": { "heading": "How do I care for my pieces?" }, "blocks": { "a3": { "type": "text", "settings": { "text": "<p>Cold hand wash and dry flat. We include a care card with every order.</p>" } } } }
      }
    }
  ]
}
{% endschema %}
