{%- comment -%}
  Contact form. Posts to /contact with Shopify's contact form, plus a rich text
  column with shop details.
{%- endcomment -%}
{{ 'component-section.css' | asset_url | stylesheet_tag }}
{{ 'component-rte.css' | asset_url | stylesheet_tag }}

<section class="section" id="contact-{{ section.id }}">
  <div class="container">
    <div class="columns" style="grid-template-columns:{{ section.settings.columns }};align-items:start">
      <div class="column">
        {%- if section.settings.heading != blank -%}
          <h2 class="h2" style="margin-bottom:12px">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte text-ink-soft" style="margin-bottom:24px">{{ section.settings.text }}</div>
        {%- endif -%}

        <ul class="footer__contact">
          {%- if section.settings.email != blank -%}
            <li class="footer__contact-item">
              {%- render 'icon', name: 'email', size: 16 -%}
              <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li class="footer__contact-item">
              {%- render 'icon', name: 'phone', size: 16 -%}
              <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.address != blank -%}
            <li class="footer__contact-item">
              {%- render 'icon', name: 'pin', size: 16 -%}
              <span>{{ section.settings.address | newline_to_br }}</span>
            </li>
          {%- endif -%}
        </ul>
      </div>

      <div class="column">
        {%- form 'contact', class: 'form', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div class="form__message form__message--success" role="status">
              {{ 'contact.success' | t }}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="form__message form__message--error" role="alert">
              <h3 style="font-size:1rem;margin-bottom:6px">{{ 'contact.error_heading' | t }}</h3>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          {%- render 'form-field', form: form, type: 'text', name: 'contact[name]', label: 'contact.form.name', value: form.name, required: true -%}
          {%- render 'form-field', form: form, type: 'email', name: 'contact[email]', label: 'contact.form.email', value: form.email, required: true -%}
          {%- render 'form-field', form: form, type: 'tel', name: 'contact[phone]', label: 'contact.form.phone', value: form.phone -%}
          {%- render 'form-field', form: form, type: 'textarea', name: 'contact[body]', label: 'contact.form.message', value: form.message, rows: 6, required: true -%}

          <button class="btn btn--accent btn--block" type="submit">{{ 'contact.form.submit' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.contact-form.settings.heading.label", "default": "Get in touch" },
    { "type": "richtext", "id": "text", "label": "t:sections.contact-form.settings.text.label", "default": "<p>Questions about sizing, an order or a custom piece? Send us a note and we will reply within one business day.</p>" },
    { "type": "text", "id": "email", "label": "t:sections.contact-form.settings.email.label" },
    { "type": "text", "id": "phone", "label": "t:sections.contact-form.settings.phone.label" },
    { "type": "textarea", "id": "address", "label": "t:sections.contact-form.settings.address.label" },
    {
      "type": "select", "id": "columns", "label": "t:sections.contact-form.settings.columns.label", "default": "repeat(2, minmax(0, 1fr))",
      "options": [
        { "value": "repeat(2, minmax(0, 1fr))", "label": "Two columns" },
        { "value": "1fr", "label": "One column" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.contact-form.presets.default" }]
}
{% endschema %}
