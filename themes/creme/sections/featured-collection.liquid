{%- comment -%}
  Featured collection: a product carousel/grid pulled from one or more
  collections, with a heading, optional banner image and "view all" link.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-section.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign limit = section.settings.products_to_show | default: 8
  assign collection = collections[section.settings.collection]

  # With no collection chosen, fall back to "All products" so a fresh install
  # fills the section in as soon as the merchant adds their first product.
  # A merchant who wants this empty simply deletes the section.
  if collection == blank
    assign collection = collections.all
  endif

  assign products = collection.products

  if section.settings.sort_by == 'featured'
    assign products = collection.products
  elsif section.settings.sort_by == 'price_asc'
    assign products = collection.products | sort: 'price'
  elsif section.settings.sort_by == 'price_desc'
    assign products = collection.products | sort: 'price' | reverse
  elsif section.settings.sort_by == 'created'
    assign products = collection.products | sort: 'created_at' | reverse
  elsif section.settings.sort_by == 'best_selling'
    assign products = collection.products | sort: 'best_selling'
  endif
  assign products = products | slice: 0, limit
-%}

{%- if products.size > 0 -%}
  <section class="section{% if section.settings.remove_top_padding %} section--flush-top{% endif %}{% if section.settings.remove_bottom_padding %} section--flush-bottom{% endif %}">
    <div class="container{% if section.settings.full_width %} container--wide{% endif %}">
      {%- render 'section-header',
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        heading_tag: section.settings.heading_tag,
        align: section.settings.header_alignment,
        link_label: section.settings.link_label,
        link_url: section.settings.link_url -%}

      <div class="grid" style="--card-min:{{ section.settings.columns_desktop }}px">
        {%- for product in products -%}
          <c-animate data-delay="{{ forloop.index0 | times: 60 }}">
            {%- render 'product-card', card_product: product, sizes: section.settings.image_size -%}
          </c-animate>
        {%- endfor -%}
      </div>

      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <div class="text-center" style="margin-top:32px">
          <a class="btn btn--outline" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.featured-collection.settings.heading.label", "default": "New arrivals" },
    { "type": "textarea", "id": "subheading", "label": "t:sections.featured-collection.settings.subheading.label" },
    {
      "type": "select", "id": "heading_tag", "label": "t:sections.featured-collection.settings.heading_tag.label", "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ]
    },
    { "type": "link_list", "id": "collection", "label": "t:sections.featured-collection.settings.collection.label" },
    {
      "type": "select", "id": "sort_by", "label": "t:sections.featured-collection.settings.sort_by.label", "default": "featured",
      "options": [
        { "value": "featured", "label": "Featured" },
        { "value": "best_selling", "label": "Best selling" },
        { "value": "created", "label": "Newest" },
        { "value": "price_asc", "label": "Price, low to high" },
        { "value": "price_desc", "label": "Price, high to low" }
      ]
    },
    { "type": "range", "id": "products_to_show", "label": "t:sections.featured-collection.settings.products_to_show.label", "min": 2, "max": 24, "step": 2, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.featured-collection.settings.columns_desktop.label", "min": 180, "max": 460, "step": 20, "unit": "px", "default": 260 },
    {
      "type": "select", "id": "image_size", "label": "t:sections.featured-collection.settings.image_size.label", "default": "(min-width: 750px) 25vw, 50vw",
      "options": [
        { "value": "(min-width: 990px) 20vw, (min-width: 749px) 33vw, 50vw", "label": "Small" },
        { "value": "(min-width: 750px) 25vw, 50vw", "label": "Medium" },
        { "value": "(min-width: 750px) 33vw, 50vw", "label": "Large" }
      ]
    },
    {
      "type": "select", "id": "header_alignment", "label": "t:sections.featured-collection.settings.header_alignment.label", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    { "type": "text", "id": "link_label", "label": "t:sections.featured-collection.settings.link_label.label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "t:sections.featured-collection.settings.link_url.label" },
    { "type": "checkbox", "id": "full_width", "label": "t:sections.featured-collection.settings.full_width.label", "default": false },
    { "type": "checkbox", "id": "remove_top_padding", "label": "t:sections.featured-collection.settings.remove_top_padding.label", "default": false },
    { "type": "checkbox", "id": "remove_bottom_padding", "label": "t:sections.featured-collection.settings.remove_bottom_padding.label", "default": false }
  ],
  "presets": [{ "name": "t:sections.featured-collection.presets.default" }]
}
{% endschema %}
