{%- comment -%}
  Article template. Banner image, meta, body, tags, share, author card and
  "read next" suggestions from the same blog.
{%- endcomment -%}
{{ 'component-blog.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<article class="section">
  <div class="container">
    <div class="article">
      {%- render 'breadcrumbs' -%}

      <header class="article__header">
        {%- if blog.title != blank -%}
          <p class="eyebrow"><a href="{{ blog.url }}">{{ blog.title }}</a></p>
        {%- endif -%}
        <h1 class="h1">{{ article.title }}</h1>
        <div class="article__meta">
          {%- if article.author != blank -%}
            <span>{{ 'blogs.by_author' | t: author: article.author }}</span>
          {%- endif -%}
          {%- if article.published_at -%}
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>
          {%- endif -%}
          {%- if article.tags.size > 0 -%}
            <span>{{ article.tags.size }} {{ 'blogs.tags' | t }}</span>
          {%- endif -%}
        </div>
      </header>

      {%- if article.image -%}
        <div class="article__banner">
          {%- render 'responsive-image', image: article.image, sizes: '(min-width: 750px) 760px, 100vw', loading: 'eager' -%}
        </div>
      {%- endif -%}

      <div class="article__body rte">
        {{ article.content }}
      </div>

      {%- if article.tags.size > 0 -%}
        <div class="article__footer">
          <p class="eyebrow">{{ 'blogs.tagged' | t }}</p>
          <div class="article__tags">
            {%- for tag in article.tags -%}
              <a class="article__tag" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_share -%}
        <div class="article__footer">
          {%- render 'social-share', url: article.url, title: article.title, show_whatsapp: true, show_copy: true -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Read next {%- endcomment -%}
    {%- if section.settings.show_related_count > 0 -%}
      {%- liquid
        assign related = article.tags | concat: article.blog.tags
        assign related_articles = blog.articles | where: 'tags', related | exclude: article
      -%}
      {%- assign related_articles = related_articles | slice: 0, section.settings.show_related_count -%}
      {%- if related_articles.size > 0 -%}
        <div style="margin-top:clamp(40px,6vw,72px)">
          <div class="section__header">
            <h2 class="h2">{{ 'blogs.keep_reading' | t }}</h2>
            <a class="link-arrow" href="{{ blog.url }}">
              {{ 'blogs.all_posts' | t }}
              {%- render 'icon', name: 'arrow-right', size: 14 -%}
            </a>
          </div>
          <div class="grid" style="--card-min:280px">
            {%- for item in related_articles -%}
              {%- render 'article-card', card_article: item -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div id="shopify-block-{{ block.id }}" style="margin-top:32px">{%- render block -%}</div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</article>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "settings": [
    { "type": "checkbox", "id": "show_share", "label": "t:sections.main-article.settings.show_share.label", "default": true },
    { "type": "range", "id": "show_related_count", "label": "t:sections.main-article.settings.show_related_count.label", "min": 0, "max": 6, "step": 2, "default": 3 }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
