{%- comment -%}
  Product grid. Pulls a hand-picked selection of products, or everything from a
  collection. Products are individual blocks so merchants can curate the order.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-section.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign grid_products = section.blocks | where: 'type', 'product'
  assign count = grid_products.size
  assign show_collection = false
  if count == 0 and section.settings.collection != blank
    assign show_collection = true
    assign grid_products = collections[section.settings.collection].products
  endif
-%}

{%- if count > 0 or show_collection -%}
  <section class="section{% if section.settings.remove_top_padding %} section--flush-top{% endif %}{% if section.settings.remove_bottom_padding %} section--flush-bottom{% endif %}">
    <div class="container{% if section.settings.full_width %} container--wide{% endif %}">
      {%- render 'section-header',
        heading: section.settings.heading,
        subheading: section.settings.subheading,
        heading_tag: section.settings.heading_tag,
        align: section.settings.header_alignment,
        link_label: section.settings.link_label,
        link_url: section.settings.link_url -%}

      <div class="grid" style="--card-min:{{ section.settings.columns_desktop }}px">
        {%- for block in grid_products -%}
          <c-animate data-delay="{{ forloop.index0 | times: 60 }}">
            {%- if block.type == 'product' -%}
              {%- render 'product-card',
                card_product: block.settings.product,
                show_vendor: block.settings.show_vendor,
                show_swatches: block.settings.show_swatches,
                show_quick_add: block.settings.show_quick_add,
                sizes: section.settings.image_size -%}
            {%- else -%}
              {%- render 'product-card',
                card_product: block.settings.collection.products.first,
                sizes: section.settings.image_size -%}
            {%- endif -%}
          </c-animate>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.product-grid.name",
  "max_blocks": 24,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.product-grid.settings.heading.label", "default": "Shop the edit" },
    { "type": "textarea", "id": "subheading", "label": "t:sections.product-grid.settings.subheading.label" },
    { "type": "select", "id": "heading_tag", "label": "t:sections.product-grid.settings.heading_tag.label", "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ] },
    { "type": "collection", "id": "collection", "label": "t:sections.product-grid.settings.collection.label", "info": "t:sections.product-grid.settings.collection.info" },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.product-grid.settings.columns_desktop.label", "min": 180, "max": 460, "step": 20, "unit": "px", "default": 260 },
    {
      "type": "select", "id": "image_size", "label": "t:sections.product-grid.settings.image_size.label", "default": "(min-width: 750px) 25vw, 50vw",
      "options": [
        { "value": "(min-width: 990px) 20vw, (min-width: 749px) 33vw, 50vw", "label": "Small" },
        { "value": "(min-width: 750px) 25vw, 50vw", "label": "Medium" },
        { "value": "(min-width: 750px) 33vw, 50vw", "label": "Large" }
      ]
    },
    {
      "type": "select", "id": "header_alignment", "label": "t:sections.product-grid.settings.header_alignment.label", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ] },
    { "type": "text", "id": "link_label", "label": "t:sections.product-grid.settings.link_label.label" },
    { "type": "url", "id": "link_url", "label": "t:sections.product-grid.settings.link_url.label" },
    { "type": "checkbox", "id": "full_width", "label": "t:sections.product-grid.settings.full_width.label", "default": false },
    { "type": "checkbox", "id": "remove_top_padding", "label": "t:sections.product-grid.settings.remove_top_padding.label", "default": false },
    { "type": "checkbox", "id": "remove_bottom_padding", "label": "t:sections.product-grid.settings.remove_bottom_padding.label", "default": false }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.product-grid.blocks.product.name",
      "settings": [
        { "type": "product", "id": "product", "label": "t:sections.product-grid.blocks.product.settings.product.label" },
        { "type": "checkbox", "id": "show_vendor", "label": "t:sections.product-grid.blocks.product.settings.show_vendor.label", "default": false },
        { "type": "checkbox", "id": "show_swatches", "label": "t:sections.product-grid.blocks.product.settings.show_swatches.label", "default": true },
        { "type": "checkbox", "id": "show_quick_add", "label": "t:sections.product-grid.blocks.product.settings.show_quick_add.label", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product-grid.presets.default",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
