{
  "type": "footer",
  "name": "Footer group",
  "sections": {
    "newsletter": {
      "type": "newsletter",
      "blocks": {
        "form": {
          "type": "form",
          "settings": {
            "show_name": false,
            "button_label": "Subscribe",
            "disclaimer": "By signing up you agree to receive marketing email. Unsubscribe any time."
          }
        }
      },
      "block_order": ["form"],
      "settings": {
        "eyebrow": "Join the list",
        "heading": "Ten percent off, always",
        "text": "Be first to see new drops, restocks and the occasional invitation.",
        "color_scheme": "ink",
        "show_decorations": false
      }
    },
    "footer": {
      "type": "footer",
      "blocks": {
        "shop": {
          "type": "menu",
          "settings": { "heading": "Shop", "menu": "main-menu" }
        },
        "help": {
          "type": "menu",
          "settings": { "heading": "Help", "menu": "footer" }
        },
        "about": {
          "type": "text",
          "settings": {
            "heading": "Our story",
            "text": "<p>Founded in a small studio, we make considered pieces designed to be worn for years, not seasons.</p>"
          }
        }
      },
      "block_order": ["shop", "help", "about"],
      "settings": {
        "text": "Small-batch fashion, made with natural fibres and a lighter footprint.",
        "show_contact": true,
        "show_social": true,
        "show_policy_links": true,
        "color_scheme": "cream"
      }
    }
  },
  "order": ["newsletter", "footer"]
}
