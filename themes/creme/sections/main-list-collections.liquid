{%- comment -%}Index of every collection in the shop, as cards.{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="section">
  <div class="container">
    <header style="text-align:center;margin-bottom:32px">
      <h1 class="h1">{{ section.settings.heading | default: 'collections.general' | t }}</h1>
      {%- if section.settings.subheading != blank -%}
        <div class="rte text-ink-soft" style="margin-top:10px">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </header>

    {%- paginate collections by section.settings.collections_per_page -%}
      {%- if collections.size > 0 -%}
        <div class="grid" style="--card-min:{{ section.settings.columns_desktop }}px">
          {%- for collection in collections -%}
            <c-animate data-delay="{{ forloop.index0 | times: 50 }}">
              {%- render 'collection-card', card_collection: collection, show_count: true -%}
            </c-animate>
          {%- endfor -%}
        </div>
        {%- render 'pagination', paginate: paginate -%}
      {%- else -%}
        <div class="collection__empty">
          {%- render 'icon', name: 'bag', size: 48 -%}
          <p class="text-ink-soft">{{ 'collections.empty' | t }}</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.main-list-collections.settings.heading.label" },
    { "type": "textarea", "id": "subheading", "label": "t:sections.main-list-collections.settings.subheading.label" },
    { "type": "range", "id": "collections_per_page", "label": "t:sections.main-list-collections.settings.collections_per_page.label", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "t:sections.main-list-collections.settings.columns_desktop.label", "min": 200, "max": 480, "step": 20, "unit": "px", "default": 300 }
  ]
}
{% endschema %}
