{%- comment -%}
  Announcement bar. Supports one or more rotating messages, an optional link,
  a themed background and a session-dismissible close button.
{%- endcomment -%}
{{ 'component-announcement-bar.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  "Show announcement bar" in Theme settings hides it store-wide; the section
  settings below style the individual messages.
{%- endcomment -%}
{%- if settings.show_announcement_bar and section.blocks.size > 0 -%}
  {%- liquid
    assign bar_bg = settings.announcement_background | default: 'ink'
    assign do_rotate = settings.announcement_rotate
    assign bg_class = 'announcement-bar--bg-' | append: bar_bg
  -%}

  <c-announcement
    class="announcement-bar {{ bg_class }}{% if do_rotate %} announcement-bar--rotate{% endif %}"
    role="region"
    aria-label="{{ 'general.announcement.label' | t | escape }}"
    {% if do_rotate %}data-rotate="{{ section.settings.rotate_speed }}"{% endif %}
  >
    <div class="announcement-bar__viewport">
      <div class="container announcement-bar__viewport">
        <div class="announcement-bar__inner">
          {%- for block in section.blocks -%}
            <div
              class="announcement-bar__message{% if forloop.first %} is-active{% endif %}"
              data-announcement-message
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != 'none' -%}
                {%- render 'icon', name: block.settings.icon, size: 15 -%}
              {%- endif -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
              {%- else -%}
                <span>{{ block.settings.text }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if settings.announcement_dismissible and section.settings.dismissible -%}
          <button class="announcement-bar__close" type="button" data-announcement-close aria-label="{{ 'general.accessibility.close' | t }}">
            {%- render 'icon', name: 'close', size: 14 -%}
          </button>
        {%- endif -%}
      </div>
    </div>
  </c-announcement>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 4,
  "settings": [
    { "type": "range", "id": "rotate_speed", "label": "t:sections.announcement-bar.settings.rotate_speed.label", "min": 3000, "max": 12000, "step": 500, "unit": "ms", "default": 5000 },
    { "type": "checkbox", "id": "dismissible", "label": "t:sections.announcement-bar.settings.dismissible.label", "default": true, "info": "t:sections.announcement-bar.settings.dismissible.info" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "t:sections.announcement-bar.blocks.message.name",
      "settings": [
        { "type": "text", "id": "text", "label": "t:sections.announcement-bar.blocks.message.settings.text.label", "default": "Complimentary shipping on orders over $150" },
        { "type": "url", "id": "link", "label": "t:sections.announcement-bar.blocks.message.settings.link.label" },
        {
          "type": "select", "id": "icon", "label": "t:sections.announcement-bar.blocks.message.settings.icon.label", "default": "truck",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "gift", "label": "Gift" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sale", "label": "Sale" },
            { "value": "info", "label": "Info" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.default",
      "blocks": [{ "type": "message" }]
    }
  ],
  "enabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
