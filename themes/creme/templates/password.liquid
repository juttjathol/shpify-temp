{%- comment -%}
  Password page (coming soon / pre-launch). Rendered inside layout/password.liquid,
  which is intentionally dependency-free.
{%- endcomment -%}

<div class="section" style="min-height:100svh;display:grid;place-items:center">
  <div class="container container--narrow" style="text-align:center;padding-block:clamp(48px,10vw,96px)">
    <div style="margin-bottom:28px">
      {%- if settings.favicon != blank -%}
        <img
          src="{{ settings.favicon | image_url: width: 120 }}"
          width="72" height="72"
          alt="{{ shop.name | escape }}"
          style="width:72px;height:72px;margin:0 auto;border-radius:var(--radius)"
        >
      {%- else -%}
        <span class="footer__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </div>

    <p class="eyebrow eyebrow--accent">{{ 'password.eyebrow' | t }}</p>
    <h1 class="h0" style="margin-bottom:18px">{{ password_page.heading | default: password_page.title | escape }}</h1>

    {%- if password_page.description != blank -%}
      <div class="rte text-ink-soft" style="max-width:54ch;margin:0 auto 32px">{{ password_page.description }}</div>
    {%- else -%}
      <p class="text-ink-soft" style="max-width:50ch;margin:0 auto 32px">{{ 'password.default_text' | t }}</p>
    {%- endif -%}

    <div class="grid" style="grid-template-columns:1fr;gap:28px;max-width:460px;margin-inline:auto;text-align:left">
      <div>
        <h2 class="h4" style="margin-bottom:12px">{{ 'password.enter_shop' | t }}</h2>
        <form action="{{ routes.root_url | password_url }}" method="post" id="PasswordForm">
          {%- if form.errors -%}
            <div class="form__message form__message--error" role="alert" style="margin-bottom:14px">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="field">
            <label class="field__label" for="Password">{{ 'password.password' | t }}</label>
            <div style="position:relative;display:flex;align-items:center">
              <input
                class="field__input"
                type="password"
                name="password"
                id="Password"
                autocomplete="current-password"
                aria-required="true"
                style="padding-right:76px"
              >
              <button
                type="button"
                data-toggle-password
                aria-controls="Password"
                style="position:absolute;right:14px;font-size:.72rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--color-ink-soft)"
              >{{ 'password.show' | t }}</button>
            </div>
          </div>

          <button class="btn btn--accent btn--block" type="submit">{{ 'password.enter' | t }}</button>
        </form>
      </div>

      <div>
        <h2 class="h4" style="margin-bottom:12px">{{ 'password.notify' | t }}</h2>
        <form action="{{ routes.contact_url }}" method="post" id="ContactPasswordForm">
          {%- if form.posted_successfully? -%}
            <div class="form__message form__message--success" role="status">{{ 'password.success' | t }}</div>
          {%- endif -%}

          <p class="text-body-sm text-ink-soft" style="margin-bottom:12px">{{ 'password.notify_text' | t }}</p>

          <div class="field">
            <label class="visually-hidden" for="PasswordEmail">{{ 'general.newsletter.email' | t }}</label>
            <input
              class="field__input"
              type="email"
              name="contact[email]"
              id="PasswordEmail"
              placeholder="{{ 'general.newsletter.email' | t | escape }}"
              autocomplete="email"
              spellcheck="false"
              required="required"
            >
          </div>

          <input type="hidden" name="contact[tags]" value="prospect, password page">
          <label class="visually-hidden" for="PasswordFirstName">{{ 'general.newsletter.name' | t }}</label>
          <input
            class="visually-hidden"
            type="text"
            name="contact[first_name]"
            id="PasswordFirstName"
            autocomplete="given-name"
            placeholder="{{ 'general.newsletter.name' | t }}"
          >

          <button class="btn btn--outline btn--block" type="submit" name="subscribe">
            {{ 'password.notify_button' | t }}
          </button>
        </form>
      </div>
    </div>

    {%- if shop.enabled_payment_types.size > 0 and password_page.show_payment_icons -%}
      <div style="margin-top:40px">
        <p class="eyebrow">{{ 'password.payment_methods' | t }}</p>
        {%- render 'payment-icons' -%}
      </div>
    {%- endif -%}

    <p style="margin-top:36px;font-size:.8rem;color:var(--color-ink-mute)">
      {{ powered_by_link }}
    </p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var input = document.getElementById('Password');
    var toggle = document.querySelector('[data-toggle-password]');
    if (!input || !toggle) return;
    var showLabel = toggle.textContent.trim();
    toggle.addEventListener('click', function () {
      var isHidden = input.type === 'password';
      input.type = isHidden ? 'text' : 'password';
      toggle.textContent = isHidden ? '{{ "password.hide" | t | escape }}' : showLabel;
      input.focus();
    });
  });
</script>
