<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ settings.text_direction | default: 'ltr' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background | default: '#fdf8f1' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    {%- if settings.external_font_host != blank -%}
      <link rel="preconnect" href="https://{{ settings.external_font_host }}" crossorigin>
    {%- endif -%}

    {%- render 'meta-tags' -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_description contains '<' %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- comment -%} Fonts: Shopify-hosted by default, optional self-hosted opt-in {%- endcomment -%}
    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
    -%}
    {%- if settings.type_body_font != blank -%}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if settings.type_heading_font != blank -%}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- render 'css-variables' -%}
    {%- render 'fonts' -%}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'placeholder-svg.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>

    {{ content_for_stylesheet }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {%- render 'icons' -%}

    {%- comment -%} Cart item count seed so the badge is right before JS boots {%- endcomment -%}
    {%- if settings.cart_type == 'drawer' -%}
      <c-toast></c-toast>
    {%- endif -%}

    {%- comment -%} Global header group {%- endcomment -%}
    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main" tabindex="-1" style="outline:none">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%} Global cart drawer {%- endcomment -%}
    {%- render 'cart-drawer' -%}

    {%- if settings.show_page_transition -%}
      <div class="page-transition" data-page-transition></div>
    {%- endif -%}

  </body>
</html>
