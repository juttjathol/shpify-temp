{%- comment -%}
  Password page layout. Shown while a store is locked (coming soon / pre-launch).
  Kept deliberately lightweight: no theme JS, no cart drawer, no header group.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="{{ settings.color_background | default: '#fdf8f1' }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}{% if password_page.title %} &ndash; {{ password_page.title }}{% endif %}</title>
    {%- if password_page.description -%}
      <meta name="description" content="{{ password_page.description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- if settings.type_body_font != blank -%}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- if settings.type_heading_font != blank -%}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {%- endif -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- render 'css-variables' -%}
  </head>

  <body class="template-password">
    {{ content_for_layout }}
  </body>
</html>
