{%- comment -%}
  Social links. Params: size, class, label_prefix
  Add or remove networks by editing config/settings_schema.json → Social accounts
  and adding a matching icon symbol to snippets/icons.liquid.
{%- endcomment -%}
{%- liquid
  assign social_size = size | default: 16
  assign social_class = class | default: ''
  assign has_any = false
  assign social_handles = settings.social_instagram | append: ',' | append: settings.social_facebook | append: ',' | append: settings.social_tiktok | append: ',' | append: settings.social_pinterest | append: ',' | append: settings.social_youtube | append: ',' | append: settings.social_x | append: ',' | append: settings.social_linkedin | append: ',' | append: settings.social_whatsapp | append: ',' | append: settings.social_tumblr | append: ',' | append: settings.social_snapchat
  for handle in social_handles
    assign handle = handle | strip
    if handle != blank
      assign has_any = true
      break
    endif
  endfor
-%}

{%- if has_any -%}
  <ul class="footer__social {{ social_class }}" role="list">
    {%- if settings.social_instagram != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{%- render 'icon', name: 'instagram', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_facebook != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{%- render 'icon', name: 'facebook', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_tiktok != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{%- render 'icon', name: 'tiktok', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_pinterest != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{%- render 'icon', name: 'pinterest', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_youtube != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{%- render 'icon', name: 'youtube', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_x != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X">{%- render 'icon', name: 'x', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_linkedin != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">{%- render 'icon', name: 'linkedin', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_whatsapp != blank -%}
      {%- assign whatsapp_number = settings.social_whatsapp | remove: '+' | remove: ' ' | remove: '-' -%}
      <li><a class="footer__social-link" href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">{%- render 'icon', name: 'whatsapp', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_tumblr != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_tumblr }}" target="_blank" rel="noopener" aria-label="Tumblr">{%- render 'icon', name: 'tumblr', size: social_size -%}</a></li>
    {%- endif -%}
    {%- if settings.social_snapchat != blank -%}
      <li><a class="footer__social-link" href="{{ settings.social_snapchat }}" target="_blank" rel="noopener" aria-label="Snapchat">{%- render 'icon', name: 'snapchat', size: social_size -%}</a></li>
    {%- endif -%}
  </ul>
{%- endif -%}
