{%- comment -%}
  Renders a Shopify video or external (YouTube/Vimeo) video.
  Params: video (media object), external_url, autoplay, loop, muted, controls
{%- endcomment -%}
{%- liquid
  assign v_autoplay = autoplay | default: false
  assign v_loop = loop | default: false
  assign v_muted = muted | default: true
  assign v_controls = controls | default: true
-%}
{%- if video != blank -%}
  {{ video | video_tag:
    image_size: '1200x',
    autoplay: v_autoplay,
    loop: v_loop,
    muted: v_muted,
    controls: v_controls,
    class: 'video__media'
  }}
{%- elsif external_url != blank -%}
  {%- assign yt_id = external_url | split: '/' | last | split: '?' | first | split: '&' | first -%}
  {%- if external_url contains 'youtu.be' or external_url contains 'youtube' -%}
    <div class="video__embed" style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:var(--radius)">
      <iframe
        src="https://www.youtube.com/embed/{{ yt_id }}?autoplay={{ v_autoplay | default: 0 }}&mute=1&loop=1&controls={{ v_controls | default: 1 }}"
        style="position:absolute;inset:0;width:100%;height:100%;border:0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
        loading="lazy"
        title="{{ 'general.media.video' | t | escape }}"
      ></iframe>
    </div>
  {%- else -%}
    <div class="video__embed" style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:var(--radius)">
      <iframe
        src="{{ external_url }}?autoplay={{ v_autoplay | default: 0 }}&mute=1&loop=1&controls={{ v_controls | default: 1 }}"
        style="position:absolute;inset:0;width:100%;height:100%;border:0"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        loading="lazy"
        title="{{ 'general.media.video' | t | escape }}"
      ></iframe>
    </div>
  {%- endif -%}
{%- endif -%}
