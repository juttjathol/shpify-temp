{%- comment -%}
  Price with compare-at and unit pricing. Params: product_or_variant, show_compare (bool), class
{%- endcomment -%}
{%- liquid
  assign target = product_or_variant
  assign show_compare = show_compare | default: true
  assign price_class = class | default: 'card__price'
-%}
<div class="{{ price_class }}">
  {%- if target.compare_at_price > target.price and show_compare -%}
    <del>{{ target.compare_at_price | money }}</del>
    <ins>{{ target.price | money }}</ins>
  {%- else -%}
    <span>{{ target.price | money }}</span>
  {%- endif -%}
  {%- if target.price_varies and target.price_min < target.price_max -%}
    <span class="text-body-xs text-ink-mute">{{ 'products.price.from' | t: price: target.price_min | money }}</span>
  {%- endif -%}
</div>
