{%- comment -%}
  Collection card. Params: card_collection, show_image, image_ratio, show_count
{%- endcomment -%}
{%- liquid
  assign c = card_collection
  assign show_image = show_image | default: true
  assign show_count = show_count | default: false
  assign img_sizes = sizes | default: '(min-width: 990px) 33vw, (min-width: 749px) 50vw, 100vw'
-%}
<a class="collection-card" href="{{ c.url }}">
  <div class="collection-card__media">
    {%- if show_image and c.featured_image -%}
      {%- render 'responsive-image', image: c.featured_image, sizes: img_sizes -%}
    {%- else -%}
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if show_count -%}
      <span class="collection-card__overlay">
        {{ 'collections.products_count' | t: count: c.products_count }}
      </span>
    {%- endif -%}
  </div>
  <h3 class="collection-card__title">{{ c.title }}</h3>
  {%- if c.description != blank and show_description -%}
    <p class="text-body-sm text-ink-soft">{{ c.description | strip_html | truncate: 90 }}</p>
  {%- endif -%}
</a>
