{%- comment -%}
  Reusable form field.
  Params: form, type (text|email|tel|password|number|textarea|select|checkbox),
          name, label, value, placeholder, required, hint, options (csv), rows, class
{%- endcomment -%}
{%- liquid
  assign f_type = type | default: 'text'
  assign f_id = name | replace: '[', '-' | replace: ']', '' | handle
  assign f_class = class | default: ''
  assign has_error = false
  if form and form.errors and form.errors[name]
    assign has_error = true
  endif
-%}
<div class="field {{ f_class }}{% if has_error %} field--error{% endif %}">
  {%- if label != blank and f_type != 'checkbox' -%}
    <label class="field__label" for="{{ f_id }}">
      {{ label }}{% if required %} <span aria-hidden="true">*</span>{% endif %}
    </label>
  {%- endif -%}

  {%- case f_type -%}
    {%- when 'textarea' -%}
      <textarea
        class="field__textarea"
        id="{{ f_id }}"
        name="{{ name }}"
        rows="{{ rows | default: 6 }}"
        placeholder="{{ placeholder | escape }}"
        {% if required %}required="required"{% endif %}
        {%- if form %}aria-describedby="{{ f_id }}-error"{% endif %}
      >{{ value }}</textarea>

    {%- when 'select' -%}
      <div class="field__select-wrap">
        <select class="field__select" id="{{ f_id }}" name="{{ name }}"{% if required %}required="required"{% endif %}>
          {%- for opt in options split: ',' -%}
            {%- assign opt_parts = opt | split: '|' -%}
            <option value="{{ opt_parts[0] | strip }}" {% if value == opt_parts[0] | strip %}selected="selected"{% endif %}>{{ opt_parts[1] | default: opt_parts[0] | strip }}</option>
          {%- endfor -%}
        </select>
        {%- render 'icon', name: 'chevron-down', size: 12 -%}
      </div>

    {%- when 'checkbox' -%}
      <label class="checkbox">
        <input type="checkbox" id="{{ f_id }}" name="{{ name }}" value="{{ value | default: '1' }}"{% if checked %}checked="checked"{% endif %}>
        <span>{{ label }}</span>
      </label>

    {%- else -%}
      <input
        class="field__input"
        id="{{ f_id }}"
        type="{{ f_type }}"
        name="{{ name }}"
        value="{{ value | escape }}"
        placeholder="{{ placeholder | escape }}"
        {% if required %}required="required"{% endif %}
        {%- if form %}aria-describedby="{{ f_id }}-error"{% endif %}
      >
  {%- endcase -%}

  {%- if has_error -%}
    <span class="field__error" id="{{ f_id }}-error">{{ form.errors[name] }}</span>
  {%- elsif hint != blank -%}
    <span class="field__error" style="color:var(--color-ink-mute)">{{ hint }}</span>
  {%- endif -%}
</div>
