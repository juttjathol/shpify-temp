{%- comment -%}
  Accessible pagination. Params: paginate (from paginate object), anchor
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list">
      {%- if paginate.previous -%}
        <li>
          <a class="pagination__item" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
            {%- render 'icon', name: 'chevron-left', size: 14 -%}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <li>
            <a class="pagination__item" href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          </li>
        {%- else -%}
          {%- if part.title == paginate.current_page -%}
            <li><span class="pagination__item is-current" aria-current="page">{{ part.title }}</span></li>
          {%- else -%}
            <li><span class="pagination__item is-disabled">{{ part.title }}</span></li>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if paginate.next -%}
        <li>
          <a class="pagination__item" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">
            {%- render 'icon', name: 'chevron-right', size: 14 -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
    <p class="pagination__meta">
      {{ 'general.pagination.summary' | t: current: paginate.current_page, total: paginate.pages }}
    </p>
  </nav>
{%- endif -%}
