{%- comment -%}
  Share links for a product or article. Params: url, title, show_copy
{%- endcomment -%}
{%- liquid
  assign share_url = url | default: canonical_url
  assign share_title = title | default: page_title | url_encode
  assign encoded_url = share_url | url_encode
-%}
<div class="product__share">
  <span>{{ 'general.share.label' | t }}</span>
  <a class="product__share-link" href="https://www.facebook.com/sharer/sharer.php?u={{ encoded_url }}" target="_blank" rel="noopener" aria-label="Facebook">{%- render 'icon', name: 'facebook', size: 15 -%}</a>
  <a class="product__share-link" href="https://pinterest.com/pin/create/button/?url={{ encoded_url }}&description={{ share_title }}" target="_blank" rel="noopener" aria-label="Pinterest">{%- render 'icon', name: 'pinterest', size: 15 -%}</a>
  <a class="product__share-link" href="https://twitter.com/intent/tweet?url={{ encoded_url }}&text={{ share_title }}" target="_blank" rel="noopener" aria-label="X">{%- render 'icon', name: 'x', size: 15 -%}</a>
  <a class="product__share-link" href="https://www.linkedin.com/sharing/share-offsite/?url={{ encoded_url }}" target="_blank" rel="noopener" aria-label="LinkedIn">{%- render 'icon', name: 'linkedin', size: 15 -%}</a>
  {%- if show_whatsapp -%}
    <a class="product__share-link" href="https://wa.me/?text={{ share_title }}%20{{ encoded_url }}" target="_blank" rel="noopener" aria-label="WhatsApp">{%- render 'icon', name: 'whatsapp', size: 15 -%}</a>
  {%- endif -%}
  {%- if show_copy -%}
    <button class="product__share-link" type="button" data-copy-link data-copy-value="{{ share_url }}" aria-label="{{ 'general.share.copy' | t }}">
      {%- render 'icon', name: 'lock', size: 15 -%}
    </button>
  {%- endif -%}
</div>
