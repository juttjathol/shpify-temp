{%- comment -%}
  Responsive <img> with width/height, lazy loading and CDN sizing.
  Params: image, sizes, widths (comma list), loading, class, alt, ratio_class
{%- endcomment -%}
{%- liquid
  assign img = image
  assign widths_list = widths | default: '360,540,720,960,1200,1600,2000'
  assign sizes_attr = sizes | default: '100vw'
-%}
{%- if img != blank -%}
  <img
    src="{{ img | image_url: width: 720 }}"
    srcset="
      {%- for w in widths_list split: ',' -%}
        {{ img | image_url: width: w }} {{ w }}w,
      {%- endfor -%}
      {{ img | image_url: width: 2000 }} 2000w
    "
    sizes="{{ sizes_attr }}"
    alt="{{ img.alt | escape }}"
    width="{{ img.width }}"
    height="{{ img.height }}"
    loading="{{ loading | default: 'lazy' }}"
    decoding="async"
    class="{{ class }}"
    {% if ratio_class %}style="aspect-ratio:{{ ratio_class }};object-fit:cover;width:100%;"{% endif %}
  >
{%- else -%}
  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
{%- endif -%}
