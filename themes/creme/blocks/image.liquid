{%- comment -%}@theme — Reusable image with optional link and caption.{%- endcomment -%}

{%- liquid
  assign img_ratio = block.settings.ratio
  assign ratio_value = 'portrait: 3 / 4, square: 1 / 1, landscape: 4 / 3, tall: 2 / 3, wide: 16 / 9, natural: auto'
  assign ratio_css = ratio_value | split: block.settings.ratio | last
-%}

<div class="block-image" style="margin-top:{{ block.settings.spacing_top }}px">
  <a href="{{ block.settings.link | default: '#' }}" {% if block.settings.link != blank %}tabindex="-1" aria-hidden="true"{% endif %}>
    <div style="overflow:hidden;border-radius:var(--radius);background:var(--color-surface-alt)">
      {%- if block.settings.image != blank -%}
        {%- render 'responsive-image',
          image: block.settings.image,
          sizes: block.settings.image_size,
          loading: 'lazy',
          class: 'w-full',
          ratio_class: ratio_css -%}
      {%- else -%}
        <div class="placeholder-svg" style="aspect-ratio:{{ ratio_css }}"></div>
      {%- endif -%}
    </div>
  </a>
  {%- if block.settings.caption != blank -%}
    <p class="text-body-xs text-ink-mute" style="margin-top:8px">{{ block.settings.caption }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.image.name",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:blocks.image.settings.image.label" },
    { "type": "select", "id": "ratio", "label": "t:blocks.image.settings.ratio.label", "default": "portrait",
      "options": [
        { "value": "portrait", "label": "Portrait (3:4)" },
        { "value": "tall", "label": "Tall (2:3)" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" },
        { "value": "natural", "label": "Natural" }
      ] },
    { "type": "select", "id": "image_size", "label": "t:blocks.image.settings.image_size.label", "default": "(min-width: 750px) 33vw, 100vw",
      "options": [
        { "value": "(min-width: 990px) 50vw, 100vw", "label": "Large" },
        { "value": "(min-width: 750px) 33vw, 100vw", "label": "Medium" },
        { "value": "(min-width: 750px) 25vw, 50vw", "label": "Small" },
        { "value": "100vw", "label": "Full width" }
      ] },
    { "type": "text", "id": "caption", "label": "t:blocks.image.settings.caption.label" },
    { "type": "url", "id": "link", "label": "t:blocks.image.settings.link.label" },
    { "type": "range", "id": "spacing_top", "label": "t:blocks.image.settings.spacing_top.label", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "t:blocks.image.presets.image" }]
}
{% endschema %}
