{%- comment -%}
  @theme
  Column container. Accepts nested theme blocks and lays each one out in a cell.
{%- endcomment -%}

{%- liquid
  assign gap = block.settings.gap
  assign columns_map = '1: 1, 2: 2, 3: 3, 4: 4'
  assign col_count = columns_map[block.settings.columns] | default: 2
-%}

<div
  class="columns"
  style="{{ inline_style }};grid-template-columns:repeat({{ col_count }}, minmax(0, 1fr))"
  data-columns="{{ col_count }}"
>
  {%- for child in block.blocks -%}
    <div class="column">{% render child %}</div>
  {%- else -%}
    <div class="column">
      <p class="text-ink-mute text-body-sm">{{ 'blocks.columns.empty' | t }}</p>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "t:blocks.columns.name",
  "settings": [
    {
      "type": "select", "id": "columns", "label": "t:blocks.columns.settings.columns.label", "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    { "type": "range", "id": "gap", "label": "t:blocks.columns.settings.gap.label", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "t:blocks.columns.presets.columns",
      "blocks": {
        "heading": { "type": "heading" },
        "text": { "type": "text" }
      }
    }
  ]
}
{% endschema %}
