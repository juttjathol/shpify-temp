{%- comment -%}@theme — Reusable rich text block.{%- endcomment -%}

<div class="block-text text-{{ block.settings.align }} text-ink-soft">
  <div class="rte" style="max-width:{{ block.settings.width }}ch;{% if block.settings.align == 'center' %}margin-inline:auto;{% endif %}">
    {{ block.settings.text }}
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.text.name",
  "settings": [
    { "type": "richtext", "id": "text", "label": "t:blocks.text.settings.text.label", "default": "<p>Share the story behind your pieces, your materials and your process.</p>" },
    { "type": "select", "id": "align", "label": "t:blocks.text.settings.align.label", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ] },
    { "type": "range", "id": "width", "label": "t:blocks.text.settings.width.label", "min": 30, "max": 100, "step": 2, "unit": "ch", "default": 60 }
  ],
  "presets": [{ "name": "t:blocks.text.presets.text" }]
}
{% endschema %}
