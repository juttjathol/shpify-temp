{%- comment -%}@theme — Single customer testimonial, reusable across sections.{%- endcomment -%}

<blockquote class="testimonial">
  {%- if block.settings.rating > 0 -%}
    <div class="testimonial__stars" aria-label="{{ block.settings.rating }} / 5">
      {%- for i in (1..5) -%}
        {%- if forloop.index <= block.settings.rating -%}
          {%- render 'icon', name: 'star', size: 15 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <p class="testimonial__quote">{{ block.settings.quote }}</p>

  <footer class="testimonial__author">
    {%- if block.settings.avatar != blank -%}
      {%- render 'responsive-image',
        image: block.settings.avatar,
        sizes: '44px',
        class: 'testimonial__avatar',
        loading: 'lazy',
        ratio_class: '1 / 1' -%}
    {%- endif -%}
    <div>
      <cite class="testimonial__name" style="font-style:normal">{{ block.settings.author }}</cite>
      {%- if block.settings.role != blank -%}
        <div class="testimonial__role">{{ block.settings.role }}</div>
      {%- endif -%}
    </div>
  </footer>
</blockquote>

{% schema %}
{
  "name": "t:blocks.testimonial.name",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "t:blocks.testimonial.settings.quote.label", "default": "The cashmere is unbelievably soft — I wear the scarf every single day." },
    { "type": "text", "id": "author", "label": "t:blocks.testimonial.settings.author.label", "default": "Amelia R." },
    { "type": "text", "id": "role", "label": "t:blocks.testimonial.settings.role.label", "default": "Verified customer" },
    { "type": "image_picker", "id": "avatar", "label": "t:blocks.testimonial.settings.avatar.label" },
    { "type": "range", "id": "rating", "label": "t:blocks.testimonial.settings.rating.label", "min": 0, "max": 5, "step": 1, "default": 5 }
  ],
  "presets": [{ "name": "t:blocks.testimonial.presets.testimonial" }]
}
{% endschema %}
