{%- comment -%}@theme — Newsletter signup form, reusable in any section or block.{%- endcomment -%}

<form
  class="inline-form"
  action="{{ routes.contact_url }}"
  method="post"
  id="Form-blk-{{ block.id }}"
  data-newsletter-form
>
  <input type="hidden" name="contact[tags]" value="newsletter">
  <input type="hidden" name="contact[country]" value="{{ country.name }}">

  <div class="field">
    <label class="visually-hidden" for="BlkEmail-{{ block.id }}">{{ 'general.newsletter.email' | t }}</label>
    <input
      class="field__input"
      id="BlkEmail-{{ block.id }}"
      type="email"
      name="contact[email]"
      value="{% if customer %}{{ customer.email }}{% endif %}"
      placeholder="{{ block.settings.placeholder | escape }}"
      autocomplete="email"
      spellcheck="false"
      required="required"
      aria-required="true"
    >
  </div>

  <button class="btn {{ block.settings.style }}" type="submit" name="subscribe">
    {{ block.settings.button_label }}
  </button>

  <div data-form-message style="flex:1 0 100%"></div>
</form>

{% schema %}
{
  "name": "t:blocks.newsletter.name",
  "settings": [
    { "type": "text", "id": "placeholder", "label": "t:blocks.newsletter.settings.placeholder.label", "default": "Your email address" },
    { "type": "text", "id": "button_label", "label": "t:blocks.newsletter.settings.button_label.label", "default": "Subscribe" },
    { "type": "select", "id": "style", "label": "t:blocks.newsletter.settings.style.label", "default": "btn--accent",
      "options": [
        { "value": "btn--accent", "label": "Solid" },
        { "value": "btn--outline", "label": "Outline" },
        { "value": "btn", "label": "Ink" }
      ] }
  ],
  "presets": [{ "name": "t:blocks.newsletter.presets.newsletter" }]
}
{% endschema %}
