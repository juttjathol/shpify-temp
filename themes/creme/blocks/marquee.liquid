{%- comment -%}@theme — Infinite scrolling text strip.{%- endcomment -%}

{%- if block.settings.text != blank -%}
  <c-marquee
    class="marquee text-{{ block.settings.color }}"
    data-speed="{{ block.settings.speed }}"
    role="marquee"
    aria-label="{{ block.settings.text | escape }}"
  >
    <div class="marquee__track" data-marquee-track>
      <span class="marquee__item">{{ block.settings.text }}</span>
    </div>
  </c-marquee>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.marquee.name",
  "settings": [
    { "type": "text", "id": "text", "label": "t:blocks.marquee.settings.text.label", "default": "Free shipping over $150 · Made in small batches · New in every week" },
    { "type": "select", "id": "color", "label": "t:blocks.marquee.settings.color.label", "default": "ink",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "accent", "label": "Accent" },
        { "value": "ink-mute", "label": "Muted" }
      ] },
    { "type": "range", "id": "speed", "label": "t:blocks.marquee.settings.speed.label", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 35 }
  ],
  "presets": [{ "name": "t:blocks.marquee.presets.marquee" }]
}
{% endschema %}
