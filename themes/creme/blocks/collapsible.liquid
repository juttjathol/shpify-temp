{%- comment -%}
  @theme
  FAQ / details item. The panel accepts nested content blocks, so answers can be
  rich text, images or buttons.
{%- endcomment -%}

<c-accordion-item class="accordion__item" id="acc-{{ block.id }}">
  <h3 class="accordion__heading">
    <button class="accordion__trigger" type="button" data-accordion-trigger aria-expanded="false">
      <span>{{ block.settings.heading }}</span>
      {%- render 'icon', name: 'plus', size: 14, class: 'accordion__icon' -%}
    </button>
  </h3>
  <div class="accordion__panel" data-accordion-panel>
    {% content_for 'blocks' %}
  </div>
</c-accordion-item>

{% schema %}
{
  "name": "t:blocks.collapsible.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:blocks.collapsible.settings.heading.label", "default": "What is your return policy?" }
  ],
  "blocks": [{ "type": "@theme" }],
  "presets": [
    {
      "name": "t:blocks.collapsible.presets.collapsible",
      "blocks": {
        "text": { "type": "text" }
      }
    }
  ]
}
{% endschema %}
