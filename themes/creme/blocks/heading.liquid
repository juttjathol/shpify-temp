{%- comment -%}
  @theme
  Reusable heading + optional subheading + optional link.
  Works inside any section or other block that accepts theme blocks.
{%- endcomment -%}

{%- liquid
  assign level = block.settings.heading_tag | default: 'h2'
  assign align = block.settings.align | default: 'left'
  assign sizes_map = 'h1: h1, h2: h2, h3: h3, h4: h4'
-%}

{%- if block.settings.heading != blank or block.settings.subheading != blank -%}
  <div class="block-heading text-{{ align }}" style="margin-bottom:{{ block.settings.spacing_bottom }}px">
    {%- if block.settings.eyebrow != blank -%}
      <p class="eyebrow{% if block.settings.eyebrow_accent %} eyebrow--accent{% endif %}">{{ block.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if block.settings.heading != blank -%}
      <{{ level }} class="{{ sizes_map[level] }}" style="margin-bottom:{{ block.settings.heading_spacing }}px">
        {{ block.settings.heading }}
      </{{ level }}>
    {%- endif -%}

    {%- if block.settings.subheading != blank -%}
      <div class="rte text-ink-soft{% if align == 'center' %} text-center{% endif %}" style="max-width:{{ block.settings.subheading_width }}ch;{% if align == 'center' %}margin-inline:auto;{% endif %}">
        {{ block.settings.subheading }}
      </div>
    {%- endif -%}

    {%- if block.settings.link_label != blank -%}
      <a class="link-arrow" href="{{ block.settings.link_url | default: '#' }}" style="margin-top:14px">
        {{ block.settings.link_label }}
        {%- render 'icon', name: 'arrow-right', size: 14 -%}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.heading.name",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:blocks.heading.settings.eyebrow.label", "default": "New in" },
    { "type": "checkbox", "id": "eyebrow_accent", "label": "t:blocks.heading.settings.eyebrow_accent.label", "default": false },
    { "type": "text", "id": "heading", "label": "t:blocks.heading.settings.heading.label", "default": "Fresh arrivals" },
    { "type": "select", "id": "heading_tag", "label": "t:blocks.heading.settings.heading_tag.label", "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }
      ] },
    { "type": "range", "id": "heading_spacing", "label": "t:blocks.heading.settings.heading_spacing.label", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "richtext", "id": "subheading", "label": "t:blocks.heading.settings.subheading.label", "default": "<p>Small-batch pieces, made to be lived in.</p>" },
    { "type": "range", "id": "subheading_width", "label": "t:blocks.heading.settings.subheading_width.label", "min": 20, "max": 90, "step": 2, "unit": "ch", "default": 56 },
    { "type": "select", "id": "align", "label": "t:blocks.heading.settings.align.label", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ] },
    { "type": "text", "id": "link_label", "label": "t:blocks.heading.settings.link_label.label" },
    { "type": "url", "id": "link_url", "label": "t:blocks.heading.settings.link_url.label" },
    { "type": "range", "id": "spacing_bottom", "label": "t:blocks.heading.settings.spacing_bottom.label", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 32 }
  ],
  "presets": [
    { "name": "t:blocks.heading.presets.heading" }
  ]
}
{% endschema %}
